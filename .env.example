# Optional: Instagram credentials for auto-filling login
IG_USERNAME=
IG_PASSWORD=

# Delay settings (in milliseconds) to mimic human behavior
MIN_LIKE_DELAY_MS=1200
MAX_LIKE_DELAY_MS=2800
MIN_NEXT_DELAY_MS=800
MAX_NEXT_DELAY_MS=1800

# Safety limit: Maximum number of story likes per run (0 = unlimited)
MAX_LIKES_PER_RUN=250
MAX_SLIDES_PER_RUN=1000
SKIP_USERS=
INCLUDE_SEEN_STORIES=false
DRY_RUN=false
USER_DATA_DIR=.browser-profile
