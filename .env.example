# Optional: Instagram credentials for auto-filling login (recommended to leave blank and log in manually once in the opened browser; session is saved in .browser-profile/)
IG_USERNAME=
IG_PASSWORD=

# Feature toggles
ENABLE_STORIES=true
ENABLE_DM_REACTIONS=true
ENABLE_CHAT_ANALYTICS=false

# DM Reel/Post Reaction & Chat Analytics settings
MAX_DM_THREADS=10
MAX_MESSAGES_PER_THREAD=8
ANALYTICS_SCROLL_PASSES=12
ANALYTICS_OUTPUT_DIR=analytics
DM_WATCH_MODE=false
DM_WATCH_INTERVAL_SEC=45

# Delay settings (in milliseconds) to mimic human behavior
MIN_LIKE_DELAY_MS=1200
MAX_LIKE_DELAY_MS=2800
MIN_NEXT_DELAY_MS=800
MAX_NEXT_DELAY_MS=1800

# Safety limit: Maximum number of story likes per run (0 = unlimited)
MAX_LIKES_PER_RUN=250

# Maximum total slides to inspect per run (0 = unlimited)
MAX_SLIDES_PER_RUN=1000

# Optional comma-separated list of usernames to skip
SKIP_USERS=

# Set to true to also re-check stories in the tray marked as already seen
INCLUDE_SEEN_STORIES=false

# Set to true to simulate without clicking the Like button or reacting
DRY_RUN=false

# Browser profile directory (stores cookies and session so you only log in once)
USER_DATA_DIR=.browser-profile
